{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facf.dev/protocol/v0alpha1/capability.schema.json",
  "title": "FACF Provider Capability",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "providerId", "capabilityId", "models", "runtime", "region", "trustTier", "slots", "expiresAt"],
  "properties": {
    "protocolVersion": { "const": "v0alpha1" },
    "providerId": { "type": "string", "minLength": 1 },
    "capabilityId": { "type": "string", "minLength": 1 },
    "models": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "runtime": { "enum": ["simulator", "ollama", "vllm"] },
    "region": { "type": "string", "minLength": 2 },
    "trustTier": { "enum": ["community", "verified", "confidential", "private"] },
    "slots": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
