{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facf.dev/protocol/v0alpha1/offer.schema.json",
  "title": "FACF Capacity Offer",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "offerId", "providerId", "capabilityId", "models", "region", "trustTier", "dataClasses", "availableSlots", "priceEur", "estimatedLatencyMs", "qualityScore", "expiresAt"],
  "properties": {
    "protocolVersion": { "const": "v0alpha1" },
    "offerId": { "type": "string", "minLength": 1 },
    "providerId": { "type": "string", "minLength": 1 },
    "capabilityId": { "type": "string", "minLength": 1 },
    "models": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "region": { "type": "string", "minLength": 2 },
    "trustTier": { "enum": ["community", "verified", "confidential", "private"] },
    "dataClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["public", "synthetic", "internal", "confidential"] } },
    "availableSlots": { "type": "integer", "minimum": 0 },
    "priceEur": { "type": "number", "minimum": 0 },
    "estimatedLatencyMs": { "type": "integer", "minimum": 0 },
    "qualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
