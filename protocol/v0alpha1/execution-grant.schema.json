{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facf.dev/protocol/v0alpha1/execution-grant.schema.json",
  "title": "FACF Execution Grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "grantId", "token", "leaseId", "workloadId", "providerId", "model", "scope", "issuedAt", "expiresAt"],
  "properties": {
    "protocolVersion": { "const": "v0alpha1" },
    "grantId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "token": { "type": "string", "minLength": 43, "maxLength": 128 },
    "leaseId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workloadId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "providerId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "model": { "type": "string", "minLength": 1, "maxLength": 128 },
    "scope": { "const": "execute:model" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
