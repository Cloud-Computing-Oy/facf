{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facf.dev/protocol/v0alpha1/execution-request.schema.json",
  "title": "FACF Remote Execution Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "executionId", "grant", "lease", "workload"],
  "properties": {
    "protocolVersion": { "const": "v0alpha1" },
    "executionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "grant": { "$ref": "execution-grant.schema.json" },
    "lease": { "$ref": "lease.schema.json" },
    "workload": {
      "allOf": [
        { "$ref": "workload.schema.json" },
        { "properties": { "dataClass": { "enum": ["public", "synthetic"] } } }
      ]
    }
  }
}
