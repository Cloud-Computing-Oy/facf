{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facf.dev/protocol/v0alpha1/workload.schema.json",
  "title": "FACF Workload",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "workloadId", "tenantId", "model", "dataClass", "minimumTrustTier", "allowedRegions", "maximumPriceEur", "timeoutMs", "input"],
  "properties": {
    "protocolVersion": { "const": "v0alpha1" },
    "workloadId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 },
    "dataClass": { "enum": ["public", "synthetic", "internal", "confidential"] },
    "minimumTrustTier": { "enum": ["community", "verified", "confidential", "private"] },
    "allowedRegions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 32 } },
    "maximumPriceEur": { "type": "number", "minimum": 0 },
    "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
    "input": { "type": "object" },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
